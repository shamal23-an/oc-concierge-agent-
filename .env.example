# Required
OPENAI_API_KEY=sk-...

# LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Qdrant (local: use HOST+PORT, cloud: use URL+API_KEY)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=oyster_collection

# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=14400

# Retrieval
CONFIDENCE_THRESHOLD=0.7
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K=5

# WhatsApp (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CALLBACK_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
CORS_ORIGINS=["http://localhost:8501","https://oc-concierge-agent-production.up.railway.app"]

# Streamlit UI
API_BASE_URL=http://localhost:8000
